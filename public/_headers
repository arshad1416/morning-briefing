# Cloudflare Pages headers — applies to the Next.js static export in out/
# Matching rules are APPENDED, not replaced: /data/*.json currently returns
#   cache-control: public, max-age=0, must-revalidate, public, max-age=0, must-revalidate
# because /* and /data/* both match and carry the same value. So a per-path rule
# here cannot override or unset a header /* already sets — giving /data/* a
# positive TTL needs a Cloudflare Cache Rule, not this file. Keep /data/* equal
# to /* so the concatenation stays self-consistent.

/*
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://secure.helcim.app; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://morning-briefing-chat.rcobwq7u.workers.dev https://secure.helcim.app; frame-src https://secure.helcim.app; img-src 'self' data:; frame-ancestors 'none'
  Strict-Transport-Security: max-age=15552000

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=0, must-revalidate

+def entry_blocked(open_trades, ticker, direction, entry_price, stop_loss, equity):
+    """Re-check the book-dependent limits against the CURRENT book.
+
+    Every limit in this pipeline used to be evaluated once, before the entry
+    loop, against the book as it stood pre-batch. So on 2026-08-03 a single run
+    entered 10 positions under MAX_PORTFOLIO_POSITIONS=5 and 3 'financial'
+    positions (JPM, V, XLF) under MAX_IN_HIGH_GROUP=2 — every candidate had been
+    scored against the same stale 4-position snapshot. Only the market-data
+    invariants (regime, confirmation, ATR stop, R:R) are safe to reuse from that
+    snapshot; these three depend on the book and must be re-read per entry.
+
+    Returns a reason string when the candidate must be skipped, else None.
+    """
+    if len(open_trades) >= MAX_PORTFOLIO_POSITIONS:
+        return f"portfolio limit {MAX_PORTFOLIO_POSITIONS}"
+
+    corr = check_correlation_limits(ticker, open_trades)
+    if not corr["allowed"]:
+        return corr["reason"]
+
+    # stop_loss is None only if the defined-risk invariant failed, in which case
+    # the candidate never reached validated=True. Skip rather than assume 0.
+    if stop_loss is not None:
+        net = check_net_portfolio_risk(
+            ticker, direction, entry_price, stop_loss, open_trades, equity)
+        if not net["allowed"]:
+            return net["reason"]
+
+    return None
+

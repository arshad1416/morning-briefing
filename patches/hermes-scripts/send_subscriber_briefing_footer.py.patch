@@ -96,7 +96,10 @@
         '<div style="font-size:10px;color:#94a3b8;margin-bottom:8px;line-height:1.5;">'
         'You are receiving the free MapleGamma Daily Briefing because you opted in. '
         f'<a href="{unsub_url(user_id)}" style="color:#94a3b8;text-decoration:underline;">Unsubscribe</a>'
-        f' · manage email on your <a href="{SITE_URL}/#/account" style="color:#94a3b8;">account page</a>.<br>'
+        # Landing-page captures have no account, and /#/account is a dead legacy-SPA
+        # hash route in any case — the working path for every recipient is the
